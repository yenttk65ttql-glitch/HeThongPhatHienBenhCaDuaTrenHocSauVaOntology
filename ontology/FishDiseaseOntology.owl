  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_EUS_ColdWater">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Epizootic_Ulcerative_Syndrome"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">25.0</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Nhiệt độ nước lạnh (&lt;25.0°C) là yếu tố kích phát dịch bệnh hàng đầu của nấm thủy mi Aphanomyces invadans (EUS).</ruleWarningMessage>
    <remedialAction xml:lang="vi">Dâng mực nước ao &gt;1.5m, hạn chế kéo lưới làm trầy xước cá; rải vôi CaCO3 (2-3 kg/100m3) để ổn định nhiệt độ tầng đáy.</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb92427b91ac408a8ae6c6ae9d2f7783">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasPrevention"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterQualityManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Edwardsiella_ictaluri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Edwardsiella ictaluri</rdfs:label>
    <rdfs:label xml:lang="vi">Vi khuẩn Edwardsiella ictaluri</rdfs:label>
    <rdfs:comment xml:lang="vi">Vi khuẩn gây bệnh gan thận mủ ở cá da trơn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#conflictingAIPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">conflicting AI prediction</rdfs:label>
    <rdfs:label xml:lang="vi">dự đoán AI mâu thuẫn</rdfs:label>
    <rdfs:comment xml:lang="vi">Nhãn dự đoán từ mô hình AI bị mâu thuẫn với thực tế lâm sàng hoặc dịch tễ.</rdfs:comment>
  </rdf:Description>
