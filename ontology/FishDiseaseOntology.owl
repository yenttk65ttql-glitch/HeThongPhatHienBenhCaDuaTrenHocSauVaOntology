  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#FishCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Fish Condition</rdfs:label>
    <rdfs:label xml:lang="vi">Tình trạng sức khỏe cá</rdfs:label>
    <rdfs:comment xml:lang="vi">Lớp gốc bao quát tất cả các trạng thái sinh lý hoặc bệnh lý của cá nuôi.</rdfs:comment>
