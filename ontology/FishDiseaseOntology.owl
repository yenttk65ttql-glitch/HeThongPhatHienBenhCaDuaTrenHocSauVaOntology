  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_BGD_LowOxygen">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dissolved_oxygen</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.5</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Hàm lượng oxy hòa tan thấp (&lt;3.5 mg/L) gây stress hô hấp nghiêm trọng và kích hoạt bệnh thối mang do Flavobacterium columnare.</ruleWarningMessage>
    <remedialAction xml:lang="vi">Tăng cường quạt nước / sục khí đáy khẩn cấp để nâng DO lên trên 4.5 mg/L.</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N12bab257b12f415383707b9baff49792">
