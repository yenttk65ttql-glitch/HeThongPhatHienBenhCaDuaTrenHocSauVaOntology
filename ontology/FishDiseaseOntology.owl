    <rdfs:label xml:lang="vi">Miền nitrit hợp lệ (0 - 10 mg/L)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Treatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
    <rdfs:label xml:lang="vi">Biện pháp điều trị</rdfs:label>
    <rdfs:comment xml:lang="vi">Phác đồ can thiệp dùng thuốc kháng sinh, sát trùng hoặc thảo dược theo quy định Bộ NN&amp;PTNT.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Pathogen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Pathogen</rdfs:label>
    <rdfs:label xml:lang="vi">Tác nhân gây bệnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Vi sinh vật gây bệnh cho cá (vi khuẩn, nấm, vi rút, ký sinh trùng).</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
