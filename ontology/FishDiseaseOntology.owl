  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WeightConfig_ClinicalHeavy">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:label xml:lang="vi">Cấu hình Ưu tiên Lâm sàng &amp; Dịch tễ</rdfs:label>
    <weightAI rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4</weightAI>
    <weightSymptom rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4</weightSymptom>
    <weightWater rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.2</weightWater>
    <configRationale xml:lang="vi">Cấu hình ưu tiên lâm sàng: Dành cho vùng nuôi đang có dịch tễ phức tạp hoặc ảnh chụp bị nhiễu ánh sáng.</configRationale>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Diagnostic Case</rdfs:label>
    <rdfs:label xml:lang="vi">Ca chẩn đoán lâm sàng</rdfs:label>
    <rdfs:comment xml:lang="vi">Biểu diễn một ca chẩn đoán thực tế tại một ao nuôi/mẫu cá cụ thể. Một instance của DiagnosticCase lưu vết các bằng chứng từ ảnh chụp, triệu chứng quan sát tại chỗ, và đo đạc chất lượng nước để đưa vào bộ suy luận tri thức.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ConflictRule_BRD_AI_vs_EUS_Epidemiology">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <conflictingAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
    <resolvedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Epizootic_Ulcerative_Syndrome"/>
    <conflictTriggerCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COLD_WATER_EUS_TRIGGER</conflictTriggerCondition>
    <conflictDescription xml:lang="vi">Bất đồng chứng cứ dịch tễ: AI dự đoán Bệnh đốm đỏ do vi khuẩn (BRD) do tổn thương ngoài da, nhưng nhiệt độ lạnh (&lt;25.0°C) và pH thấp (&lt;6.5) chỉ ra Hội chứng lở loét (EUS) do nấm Aphanomyces invadans.</conflictDescription>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N00c64782871146f5b207a95906428fff">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://www.semanticweb.org/fish-disease-ontology/2.0.0"/>
    <rdfs:label xml:lang="en">Fish Disease Ontology (FDO v2.0 - Knowledge-Driven Reasoning)</rdfs:label>
    <rdfs:label xml:lang="vi">Hệ thống tri thức Ontology Chẩn đoán bệnh cá v2.0 (Kiến trúc Suy luận Hướng Tri thức)</rdfs:label>
    <rdfs:comment xml:lang="vi">Ontology phục vụ chẩn đoán bệnh cá nước ngọt và nước lợ, kết hợp giữa mô hình học sâu (Deep Learning) và hệ suy diễn tri thức (Semantic Web/HermiT/OWL). Toàn bộ luật rủi ro môi trường, ngưỡng sinh thái học, và luật giải quyết mâu thuẫn chẩn đoán được lưu trữ trực tiếp trong Ontology, cho phép truy xuất và thực thi độc lập qua SPARQL/SWRL.</rdfs:comment>
    <dc:creator>Trương Thị Kim Yên - Chuyên ngành HTTTQL, Trường Đại học Nha Trang</dc:creator>
    <dc:publisher>Trường Đại học Nha Trang (NTU)</dc:publisher>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#triggersDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">triggers disease</rdfs:label>
    <rdfs:label xml:lang="vi">kích phát bệnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết luật rủi ro môi trường với bệnh lý tương ứng.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <rdfs:label xml:lang="en">Environmental Risk Rule</rdfs:label>
    <rdfs:label xml:lang="vi">Luật rủi ro môi trường nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Quy tắc dịch tễ học môi trường: kích hoạt rủi ro bệnh và cảnh báo khi chỉ số nước vượt ngưỡng sinh thái.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#TurbidityRange">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/fish-disease-ontology#TurbidityRange"/>
    <owl:equivalentClass rdf:nodeID="N1a50c5534e3340da8e5f5e9469e99911"/>
    <rdfs:label xml:lang="vi">Miền độ trong đĩa Secchi hợp lệ (0 - 100 cm)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#PHRange">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/fish-disease-ontology#PHRange"/>
    <owl:equivalentClass rdf:nodeID="N8278082ae51941a993b2ba4acae68264"/>
    <rdfs:label xml:lang="vi">Miền độ pH hợp lệ (0 - 14)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">has treatment</rdfs:label>
    <rdfs:label xml:lang="vi">có biện pháp điều trị</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết bệnh với phác đồ thuốc/hóa chất xử lý.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Skin Ulcers and Hemorrhage</rdfs:label>
    <rdfs:label xml:lang="vi">Loét da và xuất huyết</rdfs:label>
    <rdfs:comment xml:lang="vi">Các vết loét, đốm đỏ, hoại tử biểu mô hoặc xuất huyết vây và thân.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#resolvedDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">resolved disease</rdfs:label>
    <rdfs:label xml:lang="vi">bệnh được suy luận điều chỉnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh lý thực sự được bộ suy luận tri thức chỉ định sau khi gỡ bỏ mâu thuẫn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_BGD_HighAmmonia">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ammonia</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&gt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Nồng độ Amoniac TAN cao (&gt;0.5 mg/L) làm tổn thương phiến tơ mang và ức chế khả năng đào thải NH3 qua mang cá.</ruleWarningMessage>
    <remedialAction xml:lang="vi">Thay 20-30% nước sạch đáy ao; tạt chế phẩm vi sinh Bacillus sp. để hấp thu và chuyển hóa khí độc.</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#NutritionalImmunitySupport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">Nutritional and Immune Support</rdfs:label>
    <rdfs:label xml:lang="vi">Hỗ trợ dinh dưỡng và miễn dịch</rdfs:label>
    <rdfs:comment xml:lang="vi">Bổ sung Vitamin C (100-200 mg/kg), Beta-glucan và men vi sinh đường ruột.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb86d35f636b64b47bd26031e4aa15730">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasSymptom"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Abdominal_Distension"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh ở cá</rdfs:label>
    <rdfs:comment xml:lang="vi">Lớp đại diện cho mọi tình trạng rối loạn cấu trúc hoặc chức năng do tác nhân sinh học hoặc môi trường gây ra.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#weightWater">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">weight for water quality</rdfs:label>
    <rdfs:label xml:lang="vi">trọng số chất lượng nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Hệ số trọng số của rủi ro môi trường nước [0.0 - 1.0].</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Case_005_Conflict_Warning">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:label xml:lang="vi">Ca chẩn đoán 005 - Cảnh báo mâu thuẫn AI và Triệu chứng lâm sàng</rdfs:label>
    <hasAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <suspectedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <observedSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcer_Observation_02"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.684</confidenceScore>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasPrevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">has prevention</rdfs:label>
    <rdfs:label xml:lang="vi">có biện pháp phòng bệnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết trạng thái cá với quy trình an toàn sinh học và quản lý môi trường.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nef03b9ffb13f4a03b6bcd9a48a18db7a">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
  </rdf:Description>
