  <rdf:Description rdf:nodeID="N93964796488d46eda31978e8805f6365">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">SWRL_Rule_Conflict_Healthy_Ulcers</rdfs:label>
    <rdfs:comment xml:lang="en">DiagnosticCase(?c) ^ hasAIPrediction(?c, Healthy_Fish) ^ observedSymptom(?c, Skin_Ulcers) -&gt; hasConflict(?c, true)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Aphanomyces_invadans_Isolate_NJM9701">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Aphanomyces_invadans"/>
    <rdfs:label xml:lang="vi">Chủng nấm thủy mi Aphanomyces invadans</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N44b3e878ca334bca86f86a2927141069">
    <rdf:first rdf:nodeID="N39d725347a5742708eb72de2c4f8583c"/>
