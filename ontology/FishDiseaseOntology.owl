  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#AntisepticDisinfection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Antiseptic Disinfection</rdfs:label>
    <rdfs:label xml:lang="vi">Sát trùng nguồn nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Tạt sát trùng bằng Iodine 90 (0.3-0.5 ppm) hoặc BKC 80% (0.5-0.8 ppm).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Anabas_testudineus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <rdfs:label xml:lang="en">Climbing Perch</rdfs:label>
    <rdfs:label xml:lang="vi">Cá rô đồng</rdfs:label>
    <rdfs:comment xml:lang="vi">Loài cá bản địa dễ bị ảnh hưởng bởi nấm EUS vào mùa lạnh.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne692607170044f9883af846178b4b993">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:nodeID="N7a98b330bcf44622bbe450ccc2b38e60"/>
