  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#remedialAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">remedial action</rdfs:label>
    <rdfs:label xml:lang="vi">biện pháp cải tạo môi trường</rdfs:label>
    <rdfs:comment xml:lang="vi">Hướng dẫn kỹ thuật xử lý nước ao để loại bỏ mầm bệnh.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Normal_Behavior_Appearance_Inst">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Normal_Behavior_Appearance"/>
    <rdfs:label xml:lang="vi">Ngoại hình bình thường, bơi nhanh</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Case_001_BGD_Consistent">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:label xml:lang="vi">Ca chẩn đoán 001 - Bệnh thối mang (Đồng thuận)</rdfs:label>
    <hasAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease"/>
    <suspectedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease"/>
    <observedSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Frayed_Gills_Observation_01"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.942</confidenceScore>
    <inferredDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Enteric_Septicemia_Catfish">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease"/>
    <rdfs:label xml:lang="en">Enteric Septicemia of Catfish</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh gan thận mủ ở cá tra</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh nhiễm khuẩn máu đường ruột do vi khuẩn Edwardsiella ictaluri gây ra trên cá tra (Pangasius hypophthalmus).</rdfs:comment>
    <dc:source>Giáo trình Bệnh học Thủy sản, ĐH Cần Thơ.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#nitriteValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#NitriteRange"/>
    <rdfs:label xml:lang="en">nitrite value (NO2-)</rdfs:label>
    <rdfs:label xml:lang="vi">hàm lượng nitrit</rdfs:label>
    <rdfs:comment xml:lang="vi">Hàm lượng nitrit NO2- đo bằng mg/L.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N925f2bdb75ef41de90d512f4fe562e8f">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">SWRL_Rule_EUS_ColdWater</rdfs:label>
    <rdfs:comment xml:lang="en">DiagnosticCase(?c) ^ hasWaterCondition(?c, ?w) ^ temperatureValue(?w, ?t) ^ swrlb:lessThan(?t, 25.0) -&gt; suspectedDisease(?c, Epizootic_Ulcerative_Syndrome)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Necf7f2b926964feea45480aa17783766">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:nodeID="N0e1697aae55a4ef9b10b459c7e065d59"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_EUS_AcidicWater">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Epizootic_Ulcerative_Syndrome"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ph</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.5</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Độ pH thấp (&lt;6.5) làm tổn thương lớp nhớt biểu bì cá, tạo điều kiện cho bào tử nấm EUS xâm nhập sâu vào cơ.</ruleWarningMessage>
    <remedialAction xml:lang="vi">Bón vôi nông nghiệp CaCO3 hoặc vôi tôi Ca(OH)2 liều lượng 2-3 kg/100m3 để nâng pH lên 7.0 - 7.5.</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Salt_Bath_2Percent">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#SaltBathTreatment"/>
    <rdfs:label xml:lang="vi">Tắm nước muối 2-3% trong 5-10 phút</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndf0a4ee70eac44098ad135869d27a9dc">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:nodeID="Nd2c7d17188b14efc909be147cdbc2167"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#HealthyState"/>
    <rdfs:subClassOf rdf:nodeID="Na10da26dbea442b3aa9cd946954e28dc"/>
    <rdfs:subClassOf rdf:nodeID="N7ec14fd3863349769ba6407102d9c15a"/>
    <rdfs:label xml:lang="en">Healthy Fish Condition</rdfs:label>
    <rdfs:label xml:lang="vi">Cá khỏe mạnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Lớp đại diện cho cá không phát hiện bệnh lý, tương ứng nhãn phân loại 'Healthy Fish' trong mô hình Deep Learning.</rdfs:comment>
    <hasSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Normal_Behavior_Appearance_Inst"/>
    <hasPrevention rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pond_Water_Aeration_Liming"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#PotassiumPermanganateTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Potassium Permanganate Bath</rdfs:label>
    <rdfs:label xml:lang="vi">Tắm thuốc tím KMnO4</rdfs:label>
    <rdfs:comment xml:lang="vi">Tắm thuốc tím 2-4 ppm trong 30-45 phút sát trùng ngoại sinh vật.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#temperatureValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterTemperatureRange"/>
    <rdfs:label xml:lang="en">temperature value</rdfs:label>
    <rdfs:label xml:lang="vi">giá trị nhiệt độ</rdfs:label>
    <rdfs:comment xml:lang="vi">Nhiệt độ nước đo bằng độ C.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#BiosecurityMeasures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">Biosecurity Measures</rdfs:label>
    <rdfs:label xml:lang="vi">Biện pháp an toàn sinh học</rdfs:label>
    <rdfs:comment xml:lang="vi">Cách ly cá mới 14 ngày, khử trùng lưới cụ, kiểm tra con giống sạch mầm bệnh.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb10eccafba794b03968fd79f1b5fe5b6">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
  </rdf:Description>
