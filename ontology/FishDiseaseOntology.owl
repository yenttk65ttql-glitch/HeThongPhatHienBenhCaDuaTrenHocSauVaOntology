    <rdfs:label xml:lang="en">has AI prediction</rdfs:label>
    <rdfs:label xml:lang="vi">có dự đoán từ AI</rdfs:label>
    <rdfs:comment xml:lang="vi">Nhãn phân loại do mô hình học sâu (Deep Learning) nhận diện từ hình ảnh của ca.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Abdominal_Distension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Abdominal Distension</rdfs:label>
    <rdfs:label xml:lang="vi">Chướng bụng, sưng hậu môn</rdfs:label>
    <rdfs:comment xml:lang="vi">Bụng trướng to chứa dịch vàng hoặc hồng, hậu môn lồi đỏ.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N28ef75b689c04321b95166e69c74d5b7">
