  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#AntibioticTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Antibiotic Treatment</rdfs:label>
    <rdfs:label xml:lang="vi">Phác đồ kháng sinh</rdfs:label>
    <rdfs:comment xml:lang="vi">Sử dụng Oxytetracycline (50-75 mg/kg) hoặc Florfenicol (10 mg/kg) trộn thức ăn 5-7 ngày.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Oreochromis_niloticus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <rdfs:label xml:lang="en">Nile Tilapia</rdfs:label>
    <rdfs:label xml:lang="vi">Cá rô phi</rdfs:label>
    <rdfs:comment xml:lang="vi">Loài cá nuôi phổ biến, chịu được biến động môi trường.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#White_Spots_On_Skin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">White Spots on Skin and Gills</rdfs:label>
    <rdfs:label xml:lang="vi">Đốm trắng trên da và mang</rdfs:label>
    <rdfs:comment xml:lang="vi">Các đốm trắng hoặc u hạt mủ li ti trên biểu bì thân và mang cá.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#HerbalTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Herbal Remedy Treatment</rdfs:label>
    <rdfs:label xml:lang="vi">Trị liệu thảo dược tự nhiên</rdfs:label>
    <rdfs:comment xml:lang="vi">Bổ sung tinh dầu tỏi (Allicin) 3-5 ml/kg thức ăn để kháng khuẩn tự nhiên.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#comparisonOperator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">comparison operator</rdfs:label>
    <rdfs:label xml:lang="vi">toán tử so sánh</rdfs:label>
    <rdfs:comment xml:lang="vi">Toán tử logic so sánh số học (&lt;, &gt;, &lt;=, &gt;=).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#DissolvedOxygenRange">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DissolvedOxygenRange"/>
    <owl:equivalentClass rdf:nodeID="N4f3d77a24def494e8acc1b6bdac65451"/>
    <rdfs:label xml:lang="vi">Miền oxy hòa tan hợp lệ (0 - 20 mg/L)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1a83d48c447d486cb3c0e9504f0797cd">
    <rdf:first rdf:nodeID="N678242ae9c244da1a2d311dcabc7a7fa"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Case_004_Healthy_Fish">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:label xml:lang="vi">Ca chẩn đoán 004 - Đàn cá khỏe mạnh</rdfs:label>
    <hasAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <suspectedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <observedSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Normal_Behavior_Appearance_Inst"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.975</confidenceScore>
    <inferredDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N97712b0f12e94501a6346151d72c8be7">
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <rdfs:label xml:lang="en">Conflict Resolution Rule</rdfs:label>
    <rdfs:label xml:lang="vi">Luật giải quyết mâu thuẫn chẩn đoán</rdfs:label>
    <rdfs:comment xml:lang="vi">Quy tắc ngữ nghĩa nhận diện và xử lý bất đồng giữa dự đoán AI thị giác và thực tế lâm sàng/dịch tễ.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#SaltBathTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Salt Bath Treatment</rdfs:label>
    <rdfs:label xml:lang="vi">Tắm nước muối</rdfs:label>
    <rdfs:comment xml:lang="vi">Tắm cá trong dung dịch muối ăn NaCl 2-3% trong 5-10 phút để sát khuẩn và giảm nấm bám.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#riskScoreContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">risk score contribution</rdfs:label>
    <rdfs:label xml:lang="vi">mức độ đóng góp rủi ro</rdfs:label>
    <rdfs:comment xml:lang="vi">Điểm rủi ro môi trường bổ sung khi luật thỏa mãn [0.0 - 1.0].</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#inferredDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">inferred disease</rdfs:label>
    <rdfs:label xml:lang="vi">kết luận bệnh suy luận được</rdfs:label>
    <rdfs:comment xml:lang="vi">Kết quả chẩn đoán cuối cùng được suy diễn ra từ sự tích hợp bằng chứng ảnh, triệu chứng và thông số nước.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne0afb5a874ce4671b2e013874d245a5d">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">SWRL_Rule_BGD_LowDO</rdfs:label>
    <rdfs:comment xml:lang="en">DiagnosticCase(?c) ^ hasWaterCondition(?c, ?w) ^ dissolvedOxygenValue(?w, ?do) ^ swrlb:lessThan(?do, 3.5) -&gt; suspectedDisease(?c, Bacterial_Gill_Disease)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#weightSymptom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">weight for symptoms</rdfs:label>
    <rdfs:label xml:lang="vi">trọng số triệu chứng</rdfs:label>
    <rdfs:comment xml:lang="vi">Hệ số trọng số của triệu chứng lâm sàng [0.0 - 1.0].</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Trichodina_truttae">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Trichodina spp.</rdfs:label>
    <rdfs:label xml:lang="vi">Ký sinh trùng Trichodina</rdfs:label>
    <rdfs:comment xml:lang="vi">Trùng bánh xe ký sinh da và mang cá.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#NitriteRange">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/fish-disease-ontology#NitriteRange"/>
