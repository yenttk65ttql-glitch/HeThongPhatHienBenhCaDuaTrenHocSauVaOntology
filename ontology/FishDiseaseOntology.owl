  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Epizootic_Ulcerative_Syndrome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FungalDisease"/>
    <rdfs:subClassOf rdf:nodeID="Nf7d75954cdfc445b82c26ef887791038"/>
    <rdfs:subClassOf rdf:nodeID="N625de60f30f94beb81f718c3c35a505a"/>
    <rdfs:subClassOf rdf:nodeID="N97e108b3f00e4f7691a29004b918ad29"/>
    <rdfs:subClassOf rdf:nodeID="N28ef75b689c04321b95166e69c74d5b7"/>
    <rdfs:subClassOf rdf:nodeID="N213b0c6f015d4e00baf6599e39a39e7c"/>
    <rdfs:label xml:lang="en">Epizootic Ulcerative Syndrome (EUS)</rdfs:label>
    <rdfs:label xml:lang="vi">Hội chứng lở loét dịch tễ (EUS)</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh truyền nhiễm nguy hiểm do sinh vật Oomycete (Aphanomyces invadans) gây ra. Sợi nấm ăn sâu vào mô cơ tạo nên các vết loét hoại tử dạng u hạt (mycotic granulomas). Bệnh thường bùng phát vào mùa lạnh (nhiệt độ &lt; 25°C) hoặc sau mưa lũ kéo dài làm giảm pH nước ao.</rdfs:comment>
    <dc:source>FAO Fisheries Technical Paper No. 402, Lilley et al. (1997); WOAH Manual of Diagnostic Tests for Aquatic Animals (2021), Chapter 2.3.2.</dc:source>
    <causedBy rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Aphanomyces_invadans_Isolate_NJM9701"/>
    <hasSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcer_Observation_02"/>
    <hasTreatment rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Salt_Bath_2Percent"/>
    <hasTreatment rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Iodine_BKC_Disinfectant"/>
    <hasPrevention rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pond_Water_Aeration_Liming"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WaterCond_Case003">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <temperatureValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">21.5</temperatureValue>
    <pHValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.8</pHValue>
    <dissolvedOxygenValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.8</dissolvedOxygenValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Trichodiniasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ParasiticDisease"/>
    <rdfs:label xml:lang="en">Trichodiniasis</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh trùng bánh xe</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh do ngoại ký sinh trùng hình đĩa bánh xe Trichodina ký sinh trên mang và da cá, làm cá ngứa ngáy, tăng tiết chất nhớt.</rdfs:comment>
    <dc:source>Giáo trình Ký sinh trùng Thủy sản, ĐH Thủy sản Nha Trang.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Normal_Behavior_Appearance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Normal Behavior and Appearance</rdfs:label>
    <rdfs:label xml:lang="vi">Hành vi và ngoại hình bình thường</rdfs:label>
    <rdfs:comment xml:lang="vi">Cá bơi nhanh nhẹn, ăn khỏe, da vảy và mang sáng bóng nguyên vẹn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ammoniaValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
