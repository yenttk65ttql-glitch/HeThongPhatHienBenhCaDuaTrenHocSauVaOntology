<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://www.semanticweb.org/fish-disease-ontology#"
   xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#FungalDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">Fungal Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh do nấm và nấm nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Các bệnh do vi nấm thật hoặc sinh vật giả nấm dạng sợi (Oomycetes) gây hoại tử biểu bì và mô cơ cá.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ParasiticDisease"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf954aabfc5cc4904819b4af36189d332">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasTreatment"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#AntibioticTreatment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Gill_Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease"/>
    <rdfs:subClassOf rdf:nodeID="Nb91f899bffc44ccf9e19009f7c24792b"/>
    <rdfs:subClassOf rdf:nodeID="N5b11d93db9a542fab23c18ea8324348a"/>
    <rdfs:subClassOf rdf:nodeID="N2391abeae3a34dcf86e812b8a0a14b74"/>
    <rdfs:subClassOf rdf:nodeID="N22867418b47d4c1f978e4231b9f4c59d"/>
    <rdfs:subClassOf rdf:nodeID="Nace6028f134144849096c9800c14d2d4"/>
    <rdfs:label xml:lang="en">Bacterial Gill Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh thối mang do vi khuẩn</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh do vi khuẩn Flavobacterium branchiophilum gây ra, làm mang cá bị hoại tử, tơ mang rách xơ xác và tiết nhiều nhớt.</rdfs:comment>
    <dc:source>Giáo trình Bệnh học Thủy sản, ĐH Cần Thơ (2014); QCVN 02-19:2014/BNNPTNT.</dc:source>
    <causedBy rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Flavobacterium_columnare_Strain_FC02"/>
    <hasSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Frayed_Gills_Observation_01"/>
    <hasTreatment rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Oxytetracycline_Florfenicol"/>
    <hasTreatment rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Iodine_BKC_Disinfectant"/>
    <hasPrevention rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pond_Water_Aeration_Liming"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Pangasius_hypophthalmus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <rdfs:label xml:lang="en">Striped Catfish</rdfs:label>
    <rdfs:label xml:lang="vi">Cá tra</rdfs:label>
    <rdfs:comment xml:lang="vi">Loài cá nước ngọt xuất khẩu chủ lực vùng ĐBSCL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Saprolegnia_parasitica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Saprolegnia parasitica</rdfs:label>
    <rdfs:label xml:lang="vi">Nấm thủy mi Saprolegnia</rdfs:label>
    <rdfs:comment xml:lang="vi">Nấm nước gây màng nấm bông trắng trên cá bị thương tổn biểu bì.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#suspectedDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">suspected disease</rdfs:label>
    <rdfs:label xml:lang="vi">bệnh nghi ngờ ban đầu</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh lý ban đầu được đưa vào xem xét trước khi suy luận logic.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7ec14fd3863349769ba6407102d9c15a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasPrevention"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterQualityManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Case_002_BRD_Consistent">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:label xml:lang="vi">Ca chẩn đoán 002 - Bệnh đốm đỏ (Đồng thuận)</rdfs:label>
    <hasAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
    <suspectedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
    <observedSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcer_Observation_02"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.915</confidenceScore>
    <inferredDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#causedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">caused by</rdfs:label>
    <rdfs:label xml:lang="vi">gây ra bởi</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết bệnh với tác nhân vi sinh vật gây bệnh tương ứng.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">Bacterial Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh do vi khuẩn</rdfs:label>
    <rdfs:comment xml:lang="vi">Các bệnh truyền nhiễm do vi khuẩn Gram âm hoặc Gram dương gây ra trên cá nước ngọt.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FungalDisease"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ParasiticDisease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#conflictTriggerCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">conflict trigger condition</rdfs:label>
    <rdfs:label xml:lang="vi">điều kiện kích hoạt mâu thuẫn</rdfs:label>
    <rdfs:comment xml:lang="vi">Tên mã định danh điều kiện gây mâu thuẫn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Prevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Prevention</rdfs:label>
    <rdfs:label xml:lang="vi">Biện pháp phòng bệnh tổng hợp</rdfs:label>
    <rdfs:comment xml:lang="vi">Các quy trình an toàn sinh học và quản lý môi trường theo quy chuẩn QCVN 02-19:2014/BNNPTNT.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#configRationale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">config rationale</rdfs:label>
    <rdfs:label xml:lang="vi">cơ sở khoa học của cấu hình</rdfs:label>
    <rdfs:comment xml:lang="vi">Giải thích lâm sàng cho việc lựa chọn cấu hình trọng số.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4f3d77a24def494e8acc1b6bdac65451">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:nodeID="N5932111344e74c729ece7cf0382faf67"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Flavobacterium_columnare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Flavobacterium columnare</rdfs:label>
    <rdfs:label xml:lang="vi">Vi khuẩn Flavobacterium columnare</rdfs:label>
    <rdfs:comment xml:lang="vi">Vi khuẩn Gram âm dạng que dài gây bệnh thối mang, đốm trắng mang.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Frayed_Gills">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Frayed Gills and Necrosis</rdfs:label>
    <rdfs:label xml:lang="vi">Mang xơ xác, hoại tử mang</rdfs:label>
    <rdfs:comment xml:lang="vi">Mang cá bị rách, bạc màu, dính bùn, nhiều nhớt hoặc hoại tử các tơ mang.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_HighTemp_BacterialStress">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&gt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">30.0</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.3</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Nhiệt độ nước cao (&gt;30.0°C) gia tăng áp lực trao đổi chất và tốc độ phân chia của vi khuẩn cơ hội Aeromonas.</ruleWarningMessage>
    <remedialAction xml:lang="vi">Duy trì mực nước sâu &gt;1.5m, che lưới lan làm mát bề mặt ao và định kỳ khử trùng bằng Iodine 90 (0.4 ppm).</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb5783221197941d8b7e9b2abece9f641">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:nodeID="N46f712e4d5ea4f929859052ad8ba254e"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WaterCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Water Condition</rdfs:label>
    <rdfs:label xml:lang="vi">Điều kiện môi trường nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Tập hợp các chỉ số lý hóa đo được trong môi trường nước ao nuôi.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#confidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConfidenceScoreRange"/>
    <rdfs:label xml:lang="en">confidence score</rdfs:label>
    <rdfs:label xml:lang="vi">độ tin cậy của AI</rdfs:label>
    <rdfs:comment xml:lang="vi">Điểm xác suất chuẩn hóa của mô hình Deep Learning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasWaterCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <rdfs:label xml:lang="en">has water condition</rdfs:label>
    <rdfs:label xml:lang="vi">có điều kiện nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết ca bệnh với tập hợp số liệu chất lượng nước ao đo đạc tại thời điểm kiểm tra.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#turbidityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#TurbidityRange"/>
    <rdfs:label xml:lang="en">turbidity value</rdfs:label>
    <rdfs:label xml:lang="vi">độ đục / độ trong</rdfs:label>
    <rdfs:comment xml:lang="vi">Độ trong của nước đo bằng đĩa Secchi.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Cyprinus_carpio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <rdfs:label xml:lang="en">Common Carp</rdfs:label>
    <rdfs:label xml:lang="vi">Cá chép</rdfs:label>
    <rdfs:comment xml:lang="vi">Loài cá nước ngọt phổ biến, hay mắc bệnh thối mang khi mật độ nuôi cao.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N97e108b3f00e4f7691a29004b918ad29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasTreatment"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#AntisepticDisinfection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Excess_Mucus_Production">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Excess Mucus Secretion</rdfs:label>
    <rdfs:label xml:lang="vi">Tăng tiết chất nhớt</rdfs:label>
    <rdfs:comment xml:lang="vi">Da và mang bao phủ một lớp nhớt đục do phản ứng tự vệ chống ký sinh trùng.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Saprolegniasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FungalDisease"/>
    <rdfs:label xml:lang="en">Saprolegniasis</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh nấm thủy mi</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh do nấm nước Saprolegnia parasitica ký sinh trên các vết thương hở ngoài da, tạo đám sợi bông trắng như búi bông gòn.</rdfs:comment>
    <dc:source>Giáo trình Bệnh học Thủy sản, ĐH Cần Thơ.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Aphanomyces_invadans">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Aphanomyces invadans</rdfs:label>
    <rdfs:label xml:lang="vi">Nấm thủy mi Aphanomyces invadans</rdfs:label>
    <rdfs:comment xml:lang="vi">Nấm nước Oomycete gây hội chứng lở loét biểu mô dịch tễ (EUS).</rdfs:comment>
    <dc:source>WOAH Aquatic Manual 2021.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WeightConfig_Baseline">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:label xml:lang="vi">Cấu hình Cân bằng Lâm sàng (Baseline)</rdfs:label>
    <weightAI rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</weightAI>
    <weightSymptom rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.35</weightSymptom>
    <weightWater rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.15</weightWater>
    <configRationale xml:lang="vi">Cấu hình cân bằng lâm sàng: AI giữ vai trò định hướng chính (0.50), triệu chứng xác nhận thứ cấp (0.35), môi trường đóng vai trò xúc tác/kích phát (0.15).</configRationale>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#affectsSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <rdfs:label xml:lang="en">affects species</rdfs:label>
    <rdfs:label xml:lang="vi">ảnh hưởng đến loài cá</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết bệnh với loài cá mẫn cảm hoặc chịu tác động.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ParasiticDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">Parasitic Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh do ký sinh trùng</rdfs:label>
    <rdfs:comment xml:lang="vi">Các bệnh do ngoại ký sinh trùng (trùng bánh xe, sán lá mang, trùng quả dưa) hoặc nội ký sinh trùng.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Fin_Rot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Fin Rot and Erosion</rdfs:label>
    <rdfs:label xml:lang="vi">Thối vây, mòn vây</rdfs:label>
    <rdfs:comment xml:lang="vi">Các tia vây bị rách nát, cụt dần do vi khuẩn xâm lấn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ConflictRule_HealthyAI_vs_Pathology">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <conflictingAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <conflictTriggerCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HAS_PATHOLOGY_SYMPTOMS</conflictTriggerCondition>
    <conflictDescription xml:lang="vi">Mâu thuẫn phủ định: AI nhận diện là Cá khỏe mạnh nhưng thực tế quan sát thấy tổn thương bệnh lý hoại tử/loét da. Tiên đề tri thức tự động bác bỏ kết quả Healthy của AI.</conflictDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#ruleWarningMessage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">rule warning message</rdfs:label>
    <rdfs:label xml:lang="vi">thông điệp cảnh báo dịch tễ</rdfs:label>
    <rdfs:comment xml:lang="vi">Nội dung cảnh báo chuyên ngành giải thích cơ chế sinh học.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WeightConfig_VisionHeavy">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
    <rdfs:label xml:lang="vi">Cấu hình Ưu tiên Thị giác AI</rdfs:label>
    <weightAI rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.6</weightAI>
    <weightSymptom rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.3</weightSymptom>
    <weightWater rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.1</weightWater>
    <configRationale xml:lang="vi">Cấu hình ưu tiên thị giác: Dành cho điều kiện ảnh chụp độ nét cao, biểu hiện vết loét bề mặt rõ rệt.</configRationale>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Rule_BRD_HighAmmonia">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#EnvironmentalRiskRule"/>
    <triggersDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease"/>
    <targetParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ammonia</targetParameter>
    <comparisonOperator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&gt;</comparisonOperator>
    <thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</thresholdValue>
    <riskScoreContribution rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4</riskScoreContribution>
    <ruleWarningMessage xml:lang="vi">Khí độc Amoniac cao (&gt;0.5 mg/L) kết hợp dư thừa hữu cơ kích hoạt vi khuẩn xuất huyết Aeromonas hydrophila bùng phát.</ruleWarningMessage>
    <remedialAction xml:lang="vi">Cắt giảm 50% lượng thức ăn, xi-phông bùn đáy ao và xử lý vi sinh phân hủy chất hữu cơ.</remedialAction>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#conflictDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ConflictResolutionRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">conflict description</rdfs:label>
    <rdfs:label xml:lang="vi">mô tả bản chất mâu thuẫn</rdfs:label>
    <rdfs:comment xml:lang="vi">Giải thích chuyên môn lý do tại sao AI mâu thuẫn với lâm sàng/dịch tễ.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#VaccinationPrevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">Vaccination Prevention</rdfs:label>
    <rdfs:label xml:lang="vi">Tiêm phòng vaccine</rdfs:label>
    <rdfs:comment xml:lang="vi">Tiêm vaccine phòng bệnh gan thận mủ và đốm đỏ ở quy mô cá giống.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#HealthyState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">Healthy State</rdfs:label>
    <rdfs:label xml:lang="vi">Trạng thái khỏe mạnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Trạng thái cá phát triển bình thường, không mang mầm bệnh nguy hiểm, bơi lội nhanh nhẹn, da mang sáng bóng.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#WaterQualityManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">Water Quality Management</rdfs:label>
    <rdfs:label xml:lang="vi">Quản lý chất lượng nước ao</rdfs:label>
    <rdfs:comment xml:lang="vi">Thay nước định kỳ, tăng cường quạt khí để DO &gt; 4.5 mg/L, rải vôi ổn định pH và kiềm.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Bacterial_Red_Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease"/>
    <rdfs:subClassOf rdf:nodeID="Ndeb14e0625a04967bf7de69d31cd2798"/>
    <rdfs:subClassOf rdf:nodeID="N115a3d7049c04655aaba1e4d48043c37"/>
    <rdfs:subClassOf rdf:nodeID="Nb86d35f636b64b47bd26031e4aa15730"/>
    <rdfs:subClassOf rdf:nodeID="Nf954aabfc5cc4904819b4af36189d332"/>
    <rdfs:subClassOf rdf:nodeID="Nfb92427b91ac408a8ae6c6ae9d2f7783"/>
    <rdfs:label xml:lang="en">Bacterial Red Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh đốm đỏ do vi khuẩn</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh xuất huyết do vi khuẩn Aeromonas hydrophila gây ra, biểu hiện bằng các đốm đỏ, xuất huyết dưới da, gốc vây và loét cơ.</rdfs:comment>
    <dc:source>Giáo trình Bệnh học Thủy sản, ĐH Cần Thơ (2014); Sổ tay chẩn đoán bệnh cá nước ngọt ĐH Nha Trang.</dc:source>
    <causedBy rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Aeromonas_hydrophila_Strain_AH01"/>
    <hasSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcer_Observation_02"/>
    <hasTreatment rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Oxytetracycline_Florfenicol"/>
    <hasPrevention rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pond_Water_Aeration_Liming"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Symptom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Symptom</rdfs:label>
    <rdfs:label xml:lang="vi">Triệu chứng lâm sàng</rdfs:label>
    <rdfs:comment xml:lang="vi">Dấu hiệu bệnh lý bên ngoài hoặc hành vi bất thường quan sát được trên cá.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Aeromonas_hydrophila">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <rdfs:label xml:lang="en">Aeromonas hydrophila</rdfs:label>
    <rdfs:label xml:lang="vi">Vi khuẩn Aeromonas hydrophila</rdfs:label>
    <rdfs:comment xml:lang="vi">Vi khuẩn Gram âm gây bệnh đốm đỏ, xuất huyết hoại tử.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcer_Observation_02">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcers"/>
    <rdfs:label xml:lang="vi">Vết loét da xuất huyết cơ</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#DiagnosticRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Diagnostic and Reasoning Rule</rdfs:label>
    <rdfs:label xml:lang="vi">Luật chẩn đoán và suy luận</rdfs:label>
    <rdfs:comment xml:lang="vi">Lớp cha biểu diễn mọi quy tắc tri thức, luật dịch tễ học và luật giải quyết mâu thuẫn được lưu trữ trong Ontology.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#associatedWithWaterCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
