    <hasWaterCondition rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCond_Case003"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.887</confidenceScore>
