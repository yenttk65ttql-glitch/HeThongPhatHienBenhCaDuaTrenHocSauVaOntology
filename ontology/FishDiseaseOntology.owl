    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#DecisionWeightConfig">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Decision Weight Configuration</rdfs:label>
    <rdfs:label xml:lang="vi">Cấu hình trọng số quyết định lai</rdfs:label>
    <rdfs:comment xml:lang="vi">Định nghĩa cấu hình trọng số cho bộ hỗ trợ quyết định đa tiêu chí (AI, Triệu chứng, Môi trường nước).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasAIPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
