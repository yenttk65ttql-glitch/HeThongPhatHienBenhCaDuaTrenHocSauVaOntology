# 1. Dữ liệu hình ảnh thô và tệp trung gian (Dataset)
data/raw/
data/processed/
data/cache_224/
data/*.zip
data/*.tar.gz
audit_phash_samples/

# 2. Checkpoints trọng số mô hình lớn (Weights)
models/*.pt
models/*.pth
models/*.pkl
models/*.h5
models/*.onnx
# Giữ lại tệp cấu hình JSON và checkpoint nén chính thức
!models/class_to_idx.json
!models/efficientnet_b0_best.zip

# 3. Python & Jupyter caches
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*/*/.ipynb_checkpoints/

# 4. Môi trường ảo (Virtual Environments)
env/
venv/
.env
.venv/
conda-env/

# 5. Tệp tạm của hệ thống và phần mềm soạn thảo (Word / OS)
~$*.docx
~$*.doc
yêu cầu.docx
*.tmp
*.log
.DS_Store
Thumbs.db
desktop.ini

# 6. Tệp tải lên và kết quả Grad-CAM tạm thời trong app Streamlit
app/uploads/*.jpg
app/uploads/*.jpeg
app/uploads/*.png
!app/uploads/test_gradcam.png
