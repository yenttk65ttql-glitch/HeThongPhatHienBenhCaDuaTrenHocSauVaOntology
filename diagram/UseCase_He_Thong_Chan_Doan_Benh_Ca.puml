@startuml UseCase_He_Thong_Chan_Doan_Benh_Ca
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

actor "Kỹ thuật viên / Người nuôi" as Tech <<Primary>>
actor "Bộ suy luận Ontology\n(HermiT/SPARQL Engine)" as Onto <<System>>
actor "Chuyên gia / Quản trị viên" as Expert <<Secondary>>

rectangle "Hệ thống Hỗ trợ Chẩn đoán Bệnh cá (AI - Ontology)" {

    package "Thu thập Dữ liệu Đầu vào" {
        usecase "UC1: Tải ảnh cá bệnh" as UC1
        usecase "UC2: Nhập triệu chứng & thông số nước" as UC2
        usecase "UC2.1: Xác thực dữ liệu đầu vào\n(Input Validation)" as UC2_1
    }

    package "Xử lý Thị giác Máy tính (Deep Learning)" {
        usecase "UC3: Nhận diện bệnh qua ảnh\n(EfficientNet-B0 Top-3)" as UC3
        usecase "UC4: Xem bản đồ nhiệt Grad-CAM" as UC4
    }

    package "Suy luận & Hỗ trợ Quyết định" {
        usecase "UC5: Chẩn đoán kết hợp AI–Ontology\n(Hybrid Reasoning Engine)" as UC5
        usecase "UC6: Cảnh báo & phân giải mâu thuẫn\n(Conflict Resolution)" as UC6
        usecase "UC7: Tra cứu phác đồ điều trị\nvà biện pháp phòng ngừa" as UC7
        usecase "UC8: Xuất báo cáo ca bệnh lâm sàng\n(Clinical Report)" as UC8
    }

    package "Quản trị Tri thức" {
        usecase "UC9: Cập nhật quy tắc & ngưỡng môi trường\n(Ontology Rules Management)" as UC9
    }
}

' Quan hệ giữa Actor và Use Case
Tech --> UC1
Tech --> UC2
Tech --> UC4
Tech --> UC5
Tech --> UC7
Tech --> UC8

UC5 --> Onto : "Truy vấn SPARQL &\nkiểm tra tính nhất quán"
Expert --> UC9

' Quan hệ <<include>>
UC2 ..> UC2_1 : <<include>>
UC5 ..> UC3 : <<include>>
UC5 ..> UC2 : <<include>>
UC8 ..> UC5 : <<include>>
UC8 ..> UC7 : <<include>>

' Quan hệ <<extend>>
UC6 .> UC5 : <<extend>>\n(Khi phát hiện mâu thuẫn\ngiữa AI và lâm sàng/môi trường)
UC4 .> UC3 : <<extend>>\n(Hỗ trợ giải thích thị giác)

@enduml
